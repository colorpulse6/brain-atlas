{
  "name": "brain-atlas",
  "version": "0.2.0",
  "description": "Render an Obsidian vault as an animated 3D anatomical brain.",
  "main": "main.js",
  "scripts": {
    "build": "tsc -noEmit -skipLibCheck && node esbuild.config.mjs production",
    "lint": "eslint main.ts \"src/**/*.ts\"",
    "demo:build": "node scripts/build-demo.mjs",
    "dev": "node esbuild.config.mjs",
    "test-vaults:seed": "node scripts/seed-test-vaults.mjs",
    "test": "node --no-warnings --test test/*.test.mjs",
    "test:ab": "node test/ab/build-harness.mjs && playwright test test/ab",
    "install-local": "node scripts/install-local.mjs"
  },
  "keywords": [
    "obsidian",
    "plugin",
    "graph",
    "brain"
  ],
  "author": "colorpulse6",
  "homepage": "https://github.com/colorpulse6/brain-atlas#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/colorpulse6/brain-atlas.git"
  },
  "bugs": {
    "url": "https://github.com/colorpulse6/brain-atlas/issues"
  },
  "license": "MIT",
  "devDependencies": {
    "@eslint/js": "^9.39.4",
    "@playwright/test": "^1.60.0",
    "@types/node": "^20.11.30",
    "esbuild": "^0.21.5",
    "eslint": "^9.39.4",
    "eslint-plugin-obsidianmd": "^0.3.0",
    "obsidian": "^1.5.12",
    "pixelmatch": "^7.2.0",
    "pngjs": "^7.0.0",
    "typescript": "^5.4.5",
    "typescript-eslint": "^8.61.0"
  }
}
